# Base de datos. DIRECT_URL es requerida por Prisma para migrate/introspect —
# con un pooler tipo pgbouncer (Supabase, etc.) debe ser la conexión directa
# (no pooleada); sin pooler, puede ser igual a DATABASE_URL.
DATABASE_URL="postgresql://user:password@localhost:5432/empresas_antonio"
DIRECT_URL="postgresql://user:password@localhost:5432/empresas_antonio"

# Origen público de apps/web (sin slash final). PayPal lo usa para construir
# return_url/cancel_url del checkout estándar (redirección, sin Card Fields).
APP_BASE_URL="http://localhost:3000"

# URL pública de cada app — evita el warning de Better Auth y asegura que
# cookies/redirects usen el dominio correcto en producción. Cada app (web,
# admin) fija esta variable a su propio dominio.
BETTER_AUTH_URL="http://localhost:3000"

# Better Auth — instancia User (apps/web). Nunca compartir con ADMIN_AUTH_SECRET.
USER_AUTH_SECRET="changeme-user-secret"

# Better Auth — instancia AdminUser (apps/admin). Independiente de USER_AUTH_SECRET.
ADMIN_AUTH_SECRET="changeme-admin-secret"

# Wompi (Colombia) — llave pública segura de exponer, integrity/event/private secret NUNCA al navegador.
WOMPI_PUBLIC_KEY=""
WOMPI_INTEGRITY_SECRET=""
WOMPI_EVENT_SECRET=""
# Solo necesaria para pruebas server-to-server directas contra la API (test/wompi-sandbox-live.test.ts).
WOMPI_PRIVATE_KEY=""

# PayPal — Advanced/Expanded Checkout (Card Fields). Credenciales server-side.
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_WEBHOOK_ID=""
PAYPAL_API_BASE_URL="https://api-m.sandbox.paypal.com"

# Email transaccional
RESEND_API_KEY=""
EMAIL_FROM="no-reply@empresas-antonio.com"

# Errores
SENTRY_DSN=""
