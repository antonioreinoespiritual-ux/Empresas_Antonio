generator client {
  provider = "prisma-client-js"
  // "native" para desarrollo local; "rhel-openssl-3.0.x" es el motor que
  // corre en el runtime Lambda de Vercel — sin esto, el cliente se genera
  // solo con el binario de la máquina de build (Debian) y falla en runtime
  // con el mismo mensaje genérico "Prisma has detected that this project
  // was built on Vercel..." aunque `prisma generate` sí se haya ejecutado.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  // Supabase (y cualquier Postgres serverless-friendly) recomienda apuntar
  // DATABASE_URL al pooler de transacciones (pgbouncer) para runtime, y
  // directUrl a la conexión directa para `prisma migrate` — el pooler no
  // soporta los advisory locks que usan las migraciones. Si no usás pooler
  // (Postgres local, un solo proceso), ambas pueden apuntar al mismo valor.
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Auth de USUARIOS finales (instancia Better Auth "user" — ADR-009)
// ---------------------------------------------------------------------------

model User {
  id            String   @id @default(cuid())
  // Requerido por el esquema core de Better Auth (userSchema.name: z.string()).
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  status        String   @default("ACTIVE")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions    UserSession[]
  accounts    UserAccount[]
  roles       UserRole[]
  customer    Customer?

  @@map("users")
}

model UserSession {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_sessions")
}

model UserAccount {
  id                    String    @id @default(cuid())
  userId                String
  providerId            String
  accountId             String
  passwordHash          String?
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@map("user_accounts")
}

model UserVerification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("user_verifications")
}

// ---------------------------------------------------------------------------
// Auth de ADMINISTRADORES (instancia Better Auth "admin" — completamente
// separada de User: tablas, cookies y secreto propios. ADR-004/ADR-009)
// ---------------------------------------------------------------------------

model AdminUser {
  id        String   @id @default(cuid())
  // Requerido por el esquema core de Better Auth (userSchema.name: z.string()).
  name      String
  email     String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions AdminSession[]
  accounts AdminAccount[]
  roles    AdminRole[]

  @@map("admin_users")
}

model AdminSession {
  id        String   @id @default(cuid())
  adminId   String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  admin AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@map("admin_sessions")
}

model AdminAccount {
  id           String   @id @default(cuid())
  adminId      String
  providerId   String
  accountId    String
  passwordHash String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  admin AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@map("admin_accounts")
}

model AdminVerification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("admin_verifications")
}

// ---------------------------------------------------------------------------
// Autorización (roles/permisos separados por dominio de identidad)
// ---------------------------------------------------------------------------

model Role {
  id          String @id @default(cuid())
  name        String @unique
  permissions RolePermission[]
  userRoles   UserRole[]
  adminRoles  AdminRole[]

  @@map("roles")
}

model Permission {
  id    String @id @default(cuid())
  name  String @unique
  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model AdminRole {
  adminId String
  roleId  String

  admin AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
  role  Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([adminId, roleId])
  @@map("admin_roles")
}

// ---------------------------------------------------------------------------
// Catálogo / comercial (Product != Offer != Price — ADR dominio comercial)
// ---------------------------------------------------------------------------

enum ProductType {
  DIGITAL
  PHYSICAL
  SERVICE
  SUBSCRIPTION
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Product {
  id     String        @id @default(cuid())
  name   String
  type   ProductType
  status ProductStatus @default(DRAFT)

  offers       Offer[]
  entitlements Entitlement[]

  @@map("products")
}

model Campaign {
  id     String @id @default(cuid())
  name   String
  source String?

  offers Offer[]

  @@map("campaigns")
}

model Offer {
  id         String    @id @default(cuid())
  productId  String
  campaignId String?
  name       String
  isActive   Boolean   @default(true)
  validFrom  DateTime?
  validTo    DateTime?
  // Piel visual compartida por LANDING/CHECKOUT/THANK_YOU de esta Offer
  // (Frontend System v1). Enum cerrado a propósito — el admin nunca escribe
  // CSS, solo elige uno de los presets que resuelve packages/ui.
  themeId ThemeId @default(premium_light)

  product          Product           @relation(fields: [productId], references: [id])
  campaign         Campaign?         @relation(fields: [campaignId], references: [id])
  prices           Price[]
  checkoutSessions CheckoutSession[]
  orderItems       OrderItem[]
  pages            Page[]

  @@map("offers")
}

enum ThemeId {
  premium_light
  premium_dark
  editorial
  high_conversion
}

enum PriceInterval {
  ONE_TIME
  RECURRING
}

model Price {
  id       String        @id @default(cuid())
  offerId  String
  amount   Int
  currency String
  interval PriceInterval
  // Subconjunto de proveedores técnicamente compatibles con `currency` que el
  // admin decide ofrecer. Prisma no permite listas escalares opcionales, así
  // que [] es el valor en columna — la capa de repositorio lo traduce a/desde
  // `null` ("todos los compatibles") en el dominio. Nunca puede ampliar más
  // allá de compatibleProviders(currency), solo restringir.
  enabledProviders PaymentProviderType[] @default([])

  offer            Offer             @relation(fields: [offerId], references: [id])
  orderItems       OrderItem[]
  checkoutSessions CheckoutSession[]

  @@map("prices")
}

// ---------------------------------------------------------------------------
// Identidad comercial: Customer != User (ADR-012)
// ---------------------------------------------------------------------------

model Customer {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  userId    String?  @unique
  createdAt DateTime @default(now())

  user             User?             @relation(fields: [userId], references: [id])
  checkoutSessions CheckoutSession[]
  orders           Order[]
  entitlements     Entitlement[]

  @@map("customers")
}

// ---------------------------------------------------------------------------
// Transaccional
// ---------------------------------------------------------------------------

enum PaymentProviderType {
  WOMPI
  PAYPAL
}

enum CheckoutSessionStatus {
  STARTED
  COMPLETED
  ABANDONED
}

model CheckoutSession {
  id         String                 @id @default(cuid())
  offerId    String
  priceId    String
  customerId String
  provider   PaymentProviderType?
  status     CheckoutSessionStatus  @default(STARTED)
  createdAt  DateTime               @default(now())

  offer    Offer     @relation(fields: [offerId], references: [id])
  price    Price     @relation(fields: [priceId], references: [id])
  customer Customer  @relation(fields: [customerId], references: [id])
  order    Order?

  @@map("checkout_sessions")
}

enum OrderStatus {
  PENDING
  PAID
  CANCELLED
}

model Order {
  id                String      @id @default(cuid())
  checkoutSessionId String      @unique
  customerId        String
  status            OrderStatus @default(PENDING)
  createdAt         DateTime    @default(now())

  checkoutSession CheckoutSession @relation(fields: [checkoutSessionId], references: [id])
  customer        Customer        @relation(fields: [customerId], references: [id])
  items           OrderItem[]
  payments        Payment[]
  entitlements    Entitlement[]

  @@map("orders")
}

model OrderItem {
  id                String @id @default(cuid())
  orderId           String
  offerId           String
  priceId           String
  amountSnapshot    Int
  currencySnapshot  String

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  offer Offer @relation(fields: [offerId], references: [id])
  price Price @relation(fields: [priceId], references: [id])

  @@map("order_items")
}

enum PaymentStatus {
  PENDING
  APPROVED
  DECLINED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

model Payment {
  id                String              @id @default(cuid())
  orderId           String
  provider          PaymentProviderType
  providerReference String
  status            PaymentStatus       @default(PENDING)
  amount            Int
  currency          String
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  order   Order    @relation(fields: [orderId], references: [id])
  refunds Refund[]

  @@unique([provider, providerReference])
  @@map("payments")
}

model Refund {
  id        String   @id @default(cuid())
  paymentId String
  amount    Int
  reason    String?
  createdAt DateTime @default(now())

  payment Payment @relation(fields: [paymentId], references: [id])

  @@map("refunds")
}

enum EntitlementStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

model Entitlement {
  id            String            @id @default(cuid())
  customerId    String
  productId     String
  sourceOrderId String
  status        EntitlementStatus @default(ACTIVE)
  expiresAt     DateTime?

  customer    Customer @relation(fields: [customerId], references: [id])
  product     Product  @relation(fields: [productId], references: [id])
  sourceOrder Order    @relation(fields: [sourceOrderId], references: [id])

  @@unique([sourceOrderId, productId])
  @@map("entitlements")
}

// ---------------------------------------------------------------------------
// Integridad de procesamiento de webhooks (ADR-014)
// ---------------------------------------------------------------------------

model WebhookEvent {
  id              String              @id @default(cuid())
  provider        PaymentProviderType
  providerEventId String
  processedAt     DateTime?
  createdAt       DateTime            @default(now())

  @@unique([provider, providerEventId])
  @@map("webhook_events")
}

// ---------------------------------------------------------------------------
// Auditoría
// ---------------------------------------------------------------------------

model AuditLog {
  id        String   @id @default(cuid())
  actorType String
  actorId   String
  action    String
  entity    String
  entityId  String
  diff      Json?
  createdAt DateTime @default(now())

  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Contenido editable desde el admin (landing / checkout / thank-you) — sin
// tocar código ni desplegar. "content" es JSON validado en application/domain
// contra un schema Zod específico por "kind" (evita migraciones por cada
// campo de copy, sin perder el resto del modelo relacional fuerte).
// ---------------------------------------------------------------------------

enum PageKind {
  LANDING
  CHECKOUT
  THANK_YOU
}

enum PageStatus {
  DRAFT
  PUBLISHED
}

model Page {
  id        String     @id @default(cuid())
  offerId   String
  kind      PageKind
  slug      String?    @unique
  status    PageStatus @default(DRAFT)
  content   Json
  // Contador de concurrencia optimista (Agent Access Layer — ADR-06). Toda
  // escritura de contenido incrementa version en el mismo UPDATE que la
  // modifica (compare-and-swap atómico); nunca se lee, decide y escribe en
  // pasos separados. El panel admin y la API de agentes comparten el mismo
  // mecanismo.
  version   Int        @default(1)
  // Agrupan variantes A/B sin implementar todavía traffic split ni
  // conversión (Agent Access Layer, preparado-no-implementado). Ambas nulas
  // para toda Page que no sea una variante.
  variantGroupId String?
  variantLabel   String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  offer Offer @relation(fields: [offerId], references: [id])

  // Variantes A/B (F4 — escritura agentic, PLAN-AGENT-API-01): este
  // @@unique por sí solo NO evita dos Pages "primarias" (variantLabel NULL)
  // para el mismo (offerId, kind) — en SQL estándar NULL nunca es igual a
  // NULL, así que un unique constraint normal deja pasar múltiples NULL.
  // Ese caso lo cierra un índice único parcial agregado a mano en la
  // migración (`WHERE "variantLabel" IS NULL`) — Prisma no puede expresar
  // índices parciales de forma declarativa. Este @@unique sigue siendo
  // necesario para el caso de variantes reales (variantLabel no nulo): ahí
  // sí compara por igualdad normal y evita dos variantes con el mismo label
  // para la misma Offer+kind.
  @@unique([offerId, kind, variantLabel])
  @@map("pages")
}

// ---------------------------------------------------------------------------
// Agent Access Layer — identidad y credenciales de agentes externos
// (Claude/MCP), separadas de AdminUser y User (ARCH-AGENT-API-01).
// ---------------------------------------------------------------------------

enum ApiClientStatus {
  ACTIVE
  SUSPENDED
}

model ApiClient {
  id              String          @id @default(cuid())
  name            String
  description     String?
  status          ApiClientStatus @default(ACTIVE)
  forceReadOnly   Boolean         @default(false)
  // null = todas las Offers; [] = ninguna; array = allow-list explícita.
  // Comparte alcance entre todas las keys de este cliente — lo que varía
  // por key es el verbo (scopes), no el alcance de recursos.
  allowedOfferIds String[]
  createdByAdminId String
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  keys ApiKey[]

  @@map("api_clients")
}

model ApiKey {
  id              String    @id @default(cuid())
  apiClientId     String
  // Identificador público indexado (se muestra truncado en el panel). El
  // secreto completo nunca se almacena — solo su hash.
  keyPrefix       String    @unique
  secretHash      String
  scopes          String[]
  expiresAt       DateTime?
  revokedAt       DateTime?
  rateLimitOverride Int?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  client ApiClient @relation(fields: [apiClientId], references: [id], onDelete: Cascade)

  @@map("api_keys")
}

model AgentAuditLog {
  id             String   @id @default(cuid())
  requestId      String
  apiClientId    String
  apiKeyId       String?
  method         String
  resourceType   String
  resourceId     String?
  statusCode     Int
  latencyMs      Int
  outcome        String
  // Resumen redactado de qué cambió — nunca el body crudo ni el header
  // Authorization.
  changeSummary  Json?
  createdAt      DateTime @default(now())

  @@map("agent_audit_logs")
}

model ApiRateLimitBucket {
  apiKeyId   String
  bucketKey  String
  windowStart DateTime
  count      Int      @default(0)

  @@id([apiKeyId, bucketKey])
  @@map("api_rate_limit_buckets")
}

model PreviewToken {
  id               String    @id @default(cuid())
  pageId           String
  tokenId          String    @unique
  secretHash       String
  expiresAt        DateTime
  revokedAt        DateTime?
  createdByApiKeyId String?
  createdAt        DateTime  @default(now())

  @@map("preview_tokens")
}

model IdempotencyRecord {
  id             String   @id @default(cuid())
  apiClientId    String
  idempotencyKey String
  requestHash    String
  responseStatus Int
  responseBody   Json
  createdAt      DateTime @default(now())
  expiresAt      DateTime

  @@unique([apiClientId, idempotencyKey])
  @@map("idempotency_records")
}

enum AssetKind {
  IMAGE
  VIDEO
}

// Editor de landings v2, Fase 5 (ARCH-LANDING-EDITOR-02 §7) — biblioteca de
// medios compartida entre Offers, igual que Theme es un catálogo cerrado y
// reusable. Sin FK a Offer a propósito. `provider` queda como texto libre
// ("supabase-storage") en vez de un enum: es metadata operativa, no una
// unión cerrada que el dominio necesite validar.
model Asset {
  id        String    @id @default(cuid())
  kind      AssetKind
  url       String
  width     Int?
  height    Int?
  altText   String
  provider  String
  createdAt DateTime  @default(now())

  @@map("assets")
}
